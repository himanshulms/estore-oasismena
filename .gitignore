# WordPress - estore.oasismena
# Core IS tracked (same convention as leminar-saudi) so the whole site can be
# cloned and run. Only secrets, environment and generated media are ignored.

# Secrets / environment
wp-config.php
.htaccess

# Uploads are NOT tracked - they are 35MB of generated media and belong in a
# backup, not in the repo. Note the consequence: a fresh clone renders no
# imagery until wp-content/uploads is restored alongside the database, since
# the DB stores references to these files rather than the files themselves.
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/debug.log
*.log

# Bundled example content we do not ship
/wp-content/themes/twenty*/
/wp-content/plugins/hello.php

# Figma reference renders (regenerate from the file key in CLAUDE.md)
/figma-export/

# Build / editor artefacts
.sass-cache/
node_modules/
/wp-content/themes/estore-child/assets/scss/*.css.map
.DS_Store
.vscode/
.idea/

# Local Claude Code notes
CLAUDE.md
